#!/bin/bash

# Guide:
#
# 1. Copy this file to .env
#
#    cp .env-sample .env
#
# 2. Fill the blanks

export NODE_ENV=development
export PORT=9000
export ALLOW_HTTP=true

# Warning: PDF rendering does not work in Chrome when it is in headed mode.
export DEBUG_MODE=false

# Optional: Path to custom Chromium/Chrome executable (e.g. /usr/bin/chromium on Debian/Ubuntu)
# export PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional: Comma-separated list of API tokens for x-api-key authentication
# export API_TOKENS=secret-token-1,secret-token-2

# Optional: CORS allowed origin
# export CORS_ORIGIN=*

echo "Environment variables set!"
